<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS / Plesk Configuration for 10Q Challenge Platform
  Configures IISNode to execute server.js and routes web traffic.
-->
<configuration>
  <system.webServer>
    <!-- Enable detailed error messages for diagnostics -->
    <httpErrors errorMode="Detailed" />
    <asp scriptErrorSentToBrowser="true" />

    <handlers>
      <!-- Direct all requests to server.js through iisnode -->
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- Node Inspector / debugging rule -->
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^server.js\/debug[\/]?" />
        </rule>

        <!-- Direct static file handling -->
        <rule name="StaticContent" stopProcessing="true">
          <match url="([\S]+[.](jpg|jpeg|gif|png|css|js|ico|svg|woff|woff2|ttf|eot|pdf|json|txt|webp|avif))" />
          <action type="None" />
        </rule>

        <!-- All other requests routed to server.js -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="bin" />
          <add segment="node_modules" />
          <add segment=".git" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- iisnode settings for maximum stability on Windows Server -->
    <iisnode
      node_env="production"
      maxConcurrentRequestsPerProcess="1024"
      maxNamedPipeConnectionRetry="100"
      namedPipeConnectionRetryDelay="250"
      initialRequestBufferSize="4096"
      maxRequestBufferSize="65536"
      loggingEnabled="true"
      logDirectory="iisnode"
      debuggingEnabled="false"
      devErrorsEnabled="true"
      watchedFiles="web.config;server.js;app.js"
    />
  </system.webServer>
</configuration>
